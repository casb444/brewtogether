# Get these from your Supabase project settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL used for metadata, sitemap, and auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free launch: keep pricing hidden and configure this with an INR-capable provider when ready.
NEXT_PUBLIC_PRICING_ENABLED=false
NEXT_PUBLIC_DONATION_URL=
